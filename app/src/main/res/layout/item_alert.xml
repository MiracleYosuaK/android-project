<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <View
            android:id="@+id/viewStrip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#DC3545"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAlertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Authentication Failure"
                android:textStyle="bold"
                android:textColor="#333333"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvAlertLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lvl 12"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#DC3545"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#AAAAAA"
                    android:layout_marginHorizontal="4dp"/>

                <TextView
                    android:id="@+id/tvAlertSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Windows-Agent"
                    android:textSize="12sp"
                    android:textColor="#666666"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAlertTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10m ago"
            android:textSize="10sp"
            android:textColor="#999999"
            android:layout_gravity="top"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="8dp"/>
</LinearLayout>