    <style name="Badge" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">#FF0000</item>
        <item name="android:textSize">12sp</item>
        </style>
    <style name="Badge.Active">
        <item name="android:background">@drawable/badge_active</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Badge.Connected">
        <item name="android:background">@drawable/badge_connected</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Badge.Inactive">
        <item name="android:background">@drawable/badge_inactive</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Button.WazuhMobile.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/wazuh_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="CardView.WazuhMobile">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/background_card</item>
        <item name="android:layout_margin">8dp</item>
    </style>
    <style name="TextAppearance.WazuhMobile" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">14sp</item>
        </style>
    <style name="TextAppearance.WazuhMobile.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.WazuhMobile.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.WazuhMobile.Headline1">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.WazuhMobile.Headline2">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.WazuhMobile.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextInputLayout.WazuhMobile" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/wazuh_primary</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="Theme.WazuhMobile" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        
        <item name="colorPrimary">@color/wazuh_primary</item>
        <item name="colorPrimaryVariant">@color/wazuh_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/wazuh_secondary</item>
        <item name="colorSecondaryVariant">@color/wazuh_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <item name="android:statusBarColor">@color/wazuh_primary</item>
        
        <item name="android:windowBackground">@color/background_light</item>
    </style>
    <style name="Theme.WazuhMobile.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/wazuh_primary</item>
    </style>
